/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=self, microphone=self, geolocation=()

# ── HTML at the edge ──
# Everything else here is cached hard because it is content-addressed by a ?v=
# query. HTML is not, so it had no rule at all and fell through to the Pages
# default of revalidate-every-time: every page view, from every visitor, went
# back to origin for a document that only changes when I push.
#
# max-age=0 keeps the BROWSER revalidating, so a reader never sees a stale page
# after a deploy. s-maxage=300 lets Cloudflare answer from the edge for five
# minutes. stale-while-revalidate=86400 is the part that matters: for a day
# after that, the edge serves the cached copy INSTANTLY and refreshes it in the
# background, so nobody ever waits on origin -- including the first visitor
# after the cache expires, who otherwise pays for everyone else.
#
# The cost of being wrong is five minutes of staleness on a page I just
# deployed. Cloudflare Pages purges its cache on deploy anyway, so in practice
# it is less than that.
/*.html
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400

# The extensionless and root forms of the same documents.
/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400
/synth
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400
/architecture
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400
/chronicles
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400

# Must stay BELOW the /*.html rule above: when two rules match, the later and
# more specific one wins, and this page must never sit in a shared edge cache.
/r54a3a48a000156c0.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache, no-store, must-revalidate

# ── Static-asset caching — raises Cloudflare's edge cache-hit rate,
#    speeds repeat loads, and cuts origin traffic. ──

# styles.css is cache-busted with ?v=NN in every <link>, so a new version is
# a new URL — safe to cache forever.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — content-stable (a change would be a new filename), cache a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images & fonts change rarely — cache a month at the edge and in browsers.
/*.svg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000
/*.woff2
  Cache-Control: public, max-age=2592000

# First-party JS is cache-busted with ?v=NN in every <script> (scripts.js,
# audio-core.js, chord-theory.js, stars.js, analytics.js), so a new version is
# a new URL — safe to cache forever, exactly like styles.css. Repeat visitors
# and multi-page sessions stop re-fetching these, which lifts the edge/browser
# cache-hit rate and cuts origin requests.
/scripts.js
  Cache-Control: public, max-age=31536000, immutable
/audio-core.js
  Cache-Control: public, max-age=31536000, immutable
/chord-theory.js
  Cache-Control: public, max-age=31536000, immutable
/stars.js
  Cache-Control: public, max-age=31536000, immutable
/chord-shapes.js
  Cache-Control: public, max-age=31536000, immutable
/analytics.js
  Cache-Control: public, max-age=31536000, immutable

# Audio demos (/audio) are the heaviest thing served -- 24 MB of scale, maqam
# and reference clips. Their filenames are stable, so a change would be a new
# file: cache a month. Without a rule these fall through to the default and
# get re-fetched, which is the single biggest avoidable slice of bandwidth.
/audio/*
  Cache-Control: public, max-age=2592000
/*.mp3
  Cache-Control: public, max-age=2592000
/*.ogg
  Cache-Control: public, max-age=2592000
/*.wav
  Cache-Control: public, max-age=2592000

# Vendored libraries (pinned versions in /lib — Tone.js, Firebase, PeerJS).
# They rarely change, and a swap would be a new file, so cache a month.
/lib/*
  Cache-Control: public, max-age=2592000

# Fallback for any other JS (unversioned/one-off): a one-day TTL so a deploy is
# reflected within a day instead of being frozen.
/*.js
  Cache-Control: public, max-age=86400
