/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=self, microphone=self, geolocation=()

/r54a3a48a000156c0.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache, no-store, must-revalidate

# ── Static-asset caching — raises Cloudflare's edge cache-hit rate,
#    speeds repeat loads, and cuts origin traffic. ──

# styles.css is cache-busted with ?v=NN in every <link>, so a new version is
# a new URL — safe to cache forever.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

# Images & fonts change rarely — cache a month at the edge and in browsers.
/*.svg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000
/*.woff2
  Cache-Control: public, max-age=2592000

# First-party JS is cache-busted with ?v=NN in every <script> (scripts.js,
# audio-core.js, chord-theory.js, stars.js, analytics.js), so a new version is
# a new URL — safe to cache forever, exactly like styles.css. Repeat visitors
# and multi-page sessions stop re-fetching these, which lifts the edge/browser
# cache-hit rate and cuts origin requests.
/scripts.js
  Cache-Control: public, max-age=31536000, immutable
/audio-core.js
  Cache-Control: public, max-age=31536000, immutable
/chord-theory.js
  Cache-Control: public, max-age=31536000, immutable
/stars.js
  Cache-Control: public, max-age=31536000, immutable
/analytics.js
  Cache-Control: public, max-age=31536000, immutable

# Vendored libraries (pinned versions in /lib — Tone.js, Firebase, PeerJS).
# They rarely change, and a swap would be a new file, so cache a month.
/lib/*
  Cache-Control: public, max-age=2592000

# Fallback for any other JS (unversioned/one-off): a one-day TTL so a deploy is
# reflected within a day instead of being frozen.
/*.js
  Cache-Control: public, max-age=86400
